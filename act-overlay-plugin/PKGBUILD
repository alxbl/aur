# Maintainer: alxbl

pkgname=act-overlay-plugin
pkgver=0.19.111
pkgrel=1
pkgdesc='OverlayPlugin for Advanced Combat Tracker'
arch=('any')
url='https://github.com/OverlayPlugin/OverlayPlugin'
license=('MIT')
depends=('advanced-combat-tracker')
optdepends=('ffxiv-act-parser: FFXIV data for the overlays')
options=('!strip')
install=act-overlay-plugin.install
source=("OverlayPlugin-${pkgver}.zip::https://github.com/OverlayPlugin/OverlayPlugin/releases/download/v${pkgver}/OverlayPlugin-${pkgver}.zip")
sha256sums=('84ec07042f793752c3601cdd79f7d6cf711012222afdd956d7c723ac0347a00c')

package() {
  local dir=$pkgdir/usr/share/advanced-combat-tracker/plugins/OverlayPlugin file
  cd OverlayPlugin
  while IFS= read -r -d '' file; do
    install -Dm644 "$file" "$dir/$file"
  done < <(find . -type f ! -name LICENSE.txt -print0)
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
